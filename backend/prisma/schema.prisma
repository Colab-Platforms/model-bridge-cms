generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum WalletStatus {
  ACTIVE
  INACTIVE
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  INACTIVE
  EXPIRED
  EXHAUSTED
}

enum RequestStatus {
  PENDING
  SUCCESS
  FAILED
  PARTIAL
  STOPPED
}

enum LimitType {
  UNLIMITED
  DAILY
  WEEKLY
  MONTHLY
  QUATERLY
  YEARLY
}

enum RequestType {
  CHAT
  STREAM
  IMAGE
  AUDIO
  VIDEO
  RESEARCH
}

enum WalletTransactionType {
  TOPUP
  CREDIT_GRANT
  USAGE_DEDUCTION
  REFUND
  ADJUSTMENT
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ActivityType {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT

  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED

  API_KEY_CREATED
  API_KEY_UPDATED
  API_KEY_REVOKED

  WALLET_TOPUP
  CREDIT_GRANTED
  REFUND_ISSUED

  USER_SUSPENDED
  USER_ACTIVATED

  MODEL_CREATED
  MODEL_UPDATED
  MODEL_DISABLED

  PROVIDER_ENABLED
  PROVIDER_DISABLED
  PROVIDER_BALANCE_RECHARGED
  PROVIDER_BALANCE_ADJUSTED
  PROVIDER_LOW_BALANCE_ALERT_SENT
  PROVIDER_LOW_BALANCE_ALERT_RESOLVED
}

enum ProviderBalanceTransactionType {
  RECHARGE
  USAGE_DEDUCTION
  REFUND
  ADJUSTMENT
}

enum ModelOutputPricingUnit {
  TOKEN
  IMAGE
}

/// Dormant — no longer used for access control (see Project.planTier). Kept in the
/// schema pending a future decision on whether tiers come back for billing/
/// subscription purposes. Routing/model access is now gated purely by wallet
/// balance vs. cost (checkApiCredits.ts), not by this enum.
enum PlanTier {
  FREE
  PAYG
  SCALE
}

enum BillingProvider {
  PADDLE
  DODO
  STRIPE
  RAZORPAY
  LEMON_SQUEEZY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}

enum InvoiceStatus {
  PENDING
  ISSUED
  PAID
  VOID
}

enum BillingWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum ComplexityTier {
  SIMPLE
  MEDIUM
  COMPLEX
  REASONING
}

model Role {
  id        String    @id @default(cuid(2))
  name      String    @unique
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false) @map("isdeleted")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deletedAt")

  userRoles UserRole[]

  @@map("role")
}

model User {
  id                            String       @id @default(cuid(2))
  email                         String       @unique
  passwordHash                  String?      @map("password_hash")
  firstName                     String?      @map("first_name")
  lastName                      String?      @map("last_name")
  phoneNo                       String?      @map("phone_no")
  countryCode                   String?      @map("country_code")
  city                          String?
  state                         String?
  country                       String?
  profileImage                  String?
  paddleCustomerId              String?      @unique @map("paddle_customer_id")
  status                        UserStatus   @default(ACTIVE)
  googleId                      String?      @unique @map("google_id")
  authProvider                  AuthProvider @default(LOCAL) @map("auth_provider")
  isVerified                    Boolean      @default(false) @map("is_verified")
  emailVerificationOtpHash      String?      @map("emailVerificationOtpHash")
  emailVerificationOtpExpiresAt DateTime?    @map("emailVerificationOtpExpiresAt")
  passwordResetOtpHash          String?      @map("passwordResetOtpHash")
  passwordResetOtpExpiresAt     DateTime?    @map("passwordResetOtpExpiresAt")
  isGuideTaken                  Boolean?     @map("isGuideTaken")
  timezone                      String?
  createdAt                     DateTime     @default(now()) @map("created_at")
  updatedAt                     DateTime     @updatedAt @map("updated_at")
  createdBy                     String?      @map("created_by")
  updatedBy                     String?      @map("updated_by")
  isDeleted                     Boolean      @default(false) @map("is_deleted")
  deletedBy                     String?      @map("deleted_by")

  sessions             Session[]
  wallet               Wallet?
  userRoles            UserRole[]
  projects             Project[]
  apiKeys              ApiKey[]
  payments             Payment[]
  invoices             Invoice[]
  billingWebhookEvents BillingWebhookEvent[]
  inferenceRequests    InferenceRequest[]
  activityLogs         ActivityLog[]

  @@map("users")
}

model UserRole {
  id        String    @id @default(cuid(2))
  userId    String
  roleId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@map("userrole")
}

model Session {
  id                String    @id @default(cuid(2))
  userId            String    @map("user_id")
  refreshTokenHash  String    @map("refresh_token_hash")
  deviceName        String?   @map("device_name")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  expiresAt         DateTime? @map("expires_at")
  absoluteExpiresAt DateTime? @map("absoluteExpiresAt")
  revokedAt         DateTime? @map("revoked_at")
  lastUsedAt        DateTime? @map("lastUsedAt")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Wallet {
  id        String       @id @default(cuid(2))
  userId    String       @unique @map("user_id")
  balance   Decimal      @default(0) @db.Decimal(18, 8)
  currency  String       @default("USD")
  status    WalletStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  createdBy String?      @map("created_by")
  updatedBy String?      @map("updated_by")
  isDeleted Boolean      @default(false) @map("is_deleted")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     Payment[]
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                 String                @id @default(cuid(2))
  walletId           String                @map("wallet_id")
  inferenceRequestId String?               @map("inference_request_id")
  referenceId        String?               @map("reference_id")
  type               WalletTransactionType
  amount             Decimal               @db.Decimal(18, 8)
  balanceBefore      Decimal?              @map("balance_before") @db.Decimal(18, 8)
  balanceAfter       Decimal?              @map("balance_after") @db.Decimal(18, 8)
  description        String?               @db.Text
  createdBy          String?               @map("created_by")
  createdAt          DateTime              @default(now()) @map("created_at")
  isDeleted          Boolean               @default(false) @map("is_deleted")

  wallet           Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  inferenceRequest InferenceRequest? @relation(fields: [inferenceRequestId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([inferenceRequestId])
  @@map("wallet_transactions")
}

model Project {
  id                 String   @id @default(cuid(2))
  userId             String   @map("user_id")
  slug               String?
  name               String
  description        String?  @db.Text
  isActive           Boolean  @default(true) @map("is_active")
  /// Dormant — no longer read for access control by routing.middleware.ts. Kept
  /// (and still written/read normally) pending a future decision on whether tiers
  /// return for billing/subscription purposes. See PlanTier enum doc comment.
  planTier           PlanTier @default(FREE) @map("plan_tier")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdBy          String?  @map("created_by")
  updatedBy          String?  @map("updated_by")
  deletedBy          String?  @map("deleted_by")
  isDeleted          Boolean  @default(false) @map("is_deleted")
  id          String   @id @default(cuid(2))
  userId      String   @map("user_id")
  slug        String?
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  planTier    PlanTier @default(FREE) @map("plan_tier")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")
  deletedBy   String?  @map("deleted_by")
  isDeleted   Boolean  @default(false) @map("is_deleted")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys           ApiKey[]
  inferenceRequests InferenceRequest[]
  activityLogs      ActivityLog[]

  @@index([userId])
  @@map("projects")
}

model ApiKey {
  id          String       @id @default(cuid(2))
  userId      String       @map("user_id")
  projectId   String       @map("project_id")
  name        String?
  keyPrefix   String       @map("key_prefix")
  keyHash     String       @unique @map("key_hash")
  creditLimit Decimal?     @map("credit_limit") @db.Decimal(18, 8)
  limitType   LimitType?
  status      ApiKeyStatus @default(ACTIVE)
  lastUsedAt  DateTime?    @map("last_used_at")
  expiresAt   DateTime?    @map("expires_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  isDeleted   Boolean      @default(false) @map("is_deleted")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inferenceRequests InferenceRequest[]

  @@index([userId])
  @@index([projectId])
  @@map("api_keys")
}

model Provider {
  id           String    @id @default(cuid(2))
  slug         String?   @unique
  displayName  String?   @map("display_name")
  description  String?   @db.Text
  baseUrl      String?   @map("base_url")
  providerLogo String?   @map("provider_logo")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")

  models          Model[]
  providerBalance ProviderBalance?

  @@map("providers")
}

model ProviderBalance {
  id                    String    @id @default(cuid(2))
  providerId            String    @unique @map("provider_id")
  currentBalance        Decimal   @default(0) @map("current_balance") @db.Decimal(18, 8)
  currency              String    @default("USD")
  lowBalanceThreshold   Decimal   @default(5) @map("low_balance_threshold") @db.Decimal(18, 8)
  alertsEnabled         Boolean   @default(true) @map("alerts_enabled")
  lowBalanceAlertActive Boolean   @default(false) @map("low_balance_alert_active")
  lastAlertSentAt       DateTime? @map("last_alert_sent_at")
  lastAlertResolvedAt   DateTime? @map("last_alert_resolved_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  createdBy             String?   @map("created_by")
  updatedBy             String?   @map("updated_by")

  provider     Provider                     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  transactions ProviderBalanceTransaction[]

  @@index([alertsEnabled])
  @@index([lowBalanceAlertActive])
  @@map("provider_balances")
}

model ProviderBalanceTransaction {
  id                 String                         @id @default(cuid(2))
  providerBalanceId  String                         @map("provider_balance_id")
  inferenceRequestId String?                        @map("inference_request_id")
  referenceId        String?                        @map("reference_id")
  type               ProviderBalanceTransactionType
  amount             Decimal                        @db.Decimal(18, 8)
  balanceBefore      Decimal                        @map("balance_before") @db.Decimal(18, 8)
  balanceAfter       Decimal                        @map("balance_after") @db.Decimal(18, 8)
  description        String?                        @db.Text
  metadata           Json?
  createdBy          String?                        @map("created_by")
  createdAt          DateTime                       @default(now()) @map("created_at")
  isDeleted          Boolean                        @default(false) @map("is_deleted")

  providerBalance  ProviderBalance   @relation(fields: [providerBalanceId], references: [id], onDelete: Cascade)
  inferenceRequest InferenceRequest? @relation(fields: [inferenceRequestId], references: [id], onDelete: SetNull)

  @@index([providerBalanceId])
  @@index([inferenceRequestId])
  @@index([createdAt])
  @@map("provider_balance_transactions")
}

model Model {
  id              String  @id @default(cuid(2))
  providerId      String  @map("provider_id")
  providerModelId String? @map("provider_model_id")
  slug            String  @unique
  displayName     String? @map("display_name")
  description     String? @db.Text

  contextLength   Int?    @map("context_length")
  maxOutputTokens Int?    @map("max_output_tokens")
  tokenizer       String?

  inputPricePerToken  Decimal?               @map("input_price_per_token") @db.Decimal(18, 8)
  outputPricePerToken Decimal?               @map("output_price_per_token") @db.Decimal(18, 8)
  outputPricingUnit   ModelOutputPricingUnit @default(TOKEN) @map("output_pricing_unit")
  imageOutputPrice    Decimal?               @map("image_output_price") @db.Decimal(18, 8)

  cacheWritePricePerToken   Decimal?  @map("cache_write_price_per_token") @db.Decimal(18, 8)
  cacheReadPricePerToken    Decimal?  @map("cache_read_price_per_token") @db.Decimal(18, 8)
  
  inputModalities        String[]  @map("input_modalities")
  outputModalities       String[]  @map("output_modalities")
  supportedParameters    String[]  @map("supported_parameters")
  defaultForCapabilities String[]  @map("default_for_capabilities")
  isFreeModel            Boolean   @default(false) @map("is_free_model")
  /// Prep for future quality-based auto-routing — unpopulated (null) on all rows for
  /// now. Not read anywhere in routing logic yet; TierRoutingModel.priority is the
  /// selection signal until the catalog has real quality scores (Phase 2, deferred).
  qualityScore           Float?    @map("quality_score")
  cacheWritePricePerToken Decimal? @map("cache_write_price_per_token") @db.Decimal(18, 8)
  cacheReadPricePerToken  Decimal? @map("cache_read_price_per_token") @db.Decimal(18, 8)

  inputModalities        String[] @map("input_modalities")
  outputModalities       String[] @map("output_modalities")
  supportedParameters    String[] @map("supported_parameters")
  defaultForCapabilities String[] @map("default_for_capabilities")
  isFreeModel            Boolean  @default(false) @map("is_free_model")

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  provider           Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  inferenceRequests  InferenceRequest[]
  tierRoutings       TierRoutingModel[]
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  tierRoutingModels TierRoutingModel[]
  inferenceRequests InferenceRequest[]

  @@index([providerId])
  @@map("models")
}

/// DB-driven replacement for the old hardcoded TIER_MODEL_MAP in routing.service.ts.
/// Each row assigns one model to one complexity tier at a given priority. When "auto"
/// routing resolves a tier, it picks the lowest-priority active row whose model is
/// also active — so adding a fallback model for a tier is just a new row (higher
/// priority number), and swapping a tier's model is a DB edit, not a deploy.
model TierRoutingModel {
  id        String         @id @default(cuid(2))
  tier      ComplexityTier
  modelId   String         @map("model_id")
  priority  Int            @default(1)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([tier, modelId])
  @@index([tier, priority])
  @@map("tier_routing_models")
}

model InferenceRequest {
  id                    String           @id @default(cuid(2))
  userId                String           @map("user_id")
  projectId             String           @map("project_id")
  apiKeyId              String           @map("api_key_id")
  modelId               String           @map("model_id") 
  requestType           RequestType?
  requestedModelSlug    String?          @map("requested_model_slug")
  resolvedModelSlug     String?          @map("resolved_model_slug")
  /// Observability only — the project's plan tier at request time. No longer used to
  /// gate or cap routing decisions (see PlanTier enum doc comment).
  routedTier            PlanTier?        @map("routed_tier")
  routingReason         String?          @map("routing_reason")
  downgradedFromModelSlug String?        @map("downgraded_from_model_slug")
  complexityTier        ComplexityTier?  @map("complexity_tier")
  complexityScore       Float?           @map("complexity_score")
  stream                Boolean?
  status                RequestStatus?
  responseCompletionTimeMs Int?             @map("response_completion_time_ms")
  promptTokens          Int?             @map("prompt_tokens")
  completionTokens      Int?             @map("completion_tokens")
  totalTokens           Int?             @map("total_tokens")
  inputPriceSnapshot    Decimal?         @map("input_price_snapshot") @db.Decimal(18, 8)
  outputPriceSnapshot   Decimal?         @map("output_price_snapshot") @db.Decimal(18, 8)
  providerCost          Decimal?         @map("provider_cost") @db.Decimal(18, 8)
  platformMarkupPercent Decimal?         @map("platform_markup_percent") @db.Decimal(5, 2)
  platformMarkup        Decimal?         @map("platform_markup") @db.Decimal(18, 8)
  totalCost             Decimal?         @map("total_cost") @db.Decimal(18, 8)
  latencyMs             Int?             @map("latency_ms")
  createdAt             DateTime         @default(now()) @map("created_at")
  id                       String          @id @default(cuid(2))
  userId                   String          @map("user_id")
  projectId                String          @map("project_id")
  apiKeyId                 String          @map("api_key_id")
  modelId                  String          @map("model_id")
  requestType              RequestType?
  requestedModelSlug       String[]        @map("requested_model_slug")
  resolvedModelSlug        String?         @map("resolved_model_slug")
  routedTier               PlanTier?       @map("routed_tier")
  routingReason            String?         @map("routing_reason")
  downgradedFromModelSlug  String?         @map("downgraded_from_model_slug")
  complexityTier           ComplexityTier? @map("complexity_tier")
  complexityScore          Float?          @map("complexity_score")
  stream                   Boolean?
  status                   RequestStatus?
  responseCompletionTimeMs Int?            @map("response_completion_time_ms")
  promptTokens             Int?            @map("prompt_tokens")
  completionTokens         Int?            @map("completion_tokens")
  totalTokens              Int?            @map("total_tokens")
  inputPriceSnapshot       Decimal?        @map("input_price_snapshot") @db.Decimal(18, 8)
  outputPriceSnapshot      Decimal?        @map("output_price_snapshot") @db.Decimal(18, 8)
  providerCost             Decimal?        @map("provider_cost") @db.Decimal(18, 8)
  platformMarkupPercent    Decimal?        @map("platform_markup_percent") @db.Decimal(5, 2)
  platformMarkup           Decimal?        @map("platform_markup") @db.Decimal(18, 8)
  totalCost                Decimal?        @map("total_cost") @db.Decimal(18, 8)
  latencyMs                Int?            @map("latency_ms")
  createdAt                DateTime        @default(now()) @map("created_at")

  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                     Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiKey                      ApiKey                       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  model                       Model                        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  walletTransactions          WalletTransaction[]
  providerBalanceTransactions ProviderBalanceTransaction[]
  requestMetadata             RequestMetadata[]

  // @@index([userId])
  // @@index([projectId])
  // @@index([apiKeyId])
  @@index([modelId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([modelId, createdAt])
  @@index([status, createdAt])
  @@index([requestType, createdAt])
  @@map("inference_requests")
}

model RequestMetadata {
  id                 String   @id @default(cuid(2))
  inferenceRequestId String   @map("inference_request_id")
  requestPayload     Json?    @map("request_payload")
  responseMetadata   Json?    @map("response_metadata")
  createdAt          DateTime @default(now()) @map("created_at")
  isDeleted          Boolean  @default(false) @map("is_deleted")

  inferenceRequest InferenceRequest @relation(fields: [inferenceRequestId], references: [id], onDelete: Cascade)

  @@index([inferenceRequestId])
  @@map("request_metadata")
}

model ActivityLog {
  id           String       @id @default(cuid(2))
  userId       String?      @map("user_id")
  projectId    String?      @map("project_id")
  activityType ActivityType @map("activity_type")
  entityType   String?      @map("entity_type")
  entityId     String?      @map("entity_id")
  metadata     Json?
  ipAddress    String?      @map("ip_address")
  userAgent    String?      @map("user_agent") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  createdBy    String?      @map("created_by")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([entityType])
  @@index([entityId])
  @@map("activity_logs")
}

model Payment {
  id                    String          @id @default(cuid(2))
  userId                String          @map("user_id")
  walletId              String          @map("wallet_id")
  provider              BillingProvider
  providerTransactionId String          @unique @map("provider_transaction_id")
  providerCustomerId    String?         @map("provider_customer_id")
  invoiceId             String?         @unique @map("invoice_id")
  amount                Decimal         @db.Decimal(18, 8)
  currency              String          @default("USD")
  status                PaymentStatus   @default(PENDING)
  metadata              Json?
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet  Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  invoice Invoice?

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([provider, status])
  @@map("payments")
}

model Invoice {
  id                String        @id @default(cuid(2))
  paymentId         String        @unique @map("payment_id")
  userId            String        @map("user_id")
  providerInvoiceId String?       @unique @map("provider_invoice_id")
  providerInvoiceUrl String?      @map("provider_invoice_url")
  invoiceNumber     String?       @map("invoice_number")
  invoiceUrl        String?       @map("invoice_url")
  amount            Decimal       @db.Decimal(18, 8)
  currency          String        @default("USD")
  status            InvoiceStatus @default(PENDING)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("invoices")
}

model BillingWebhookEvent {
  id                     String               @id @default(cuid(2))
  userId                 String?              @map("user_id")
  provider               BillingProvider
  providerEventId        String               @unique @map("provider_event_id")
  providerNotificationId String?              @unique @map("provider_notification_id")
  eventType              String               @map("event_type")
  signature              String?              @db.Text
  payloadHash            String               @map("payload_hash")
  rawBody                String               @map("raw_body") @db.Text
  status                 BillingWebhookStatus @default(RECEIVED)
  errorMessage           String?              @map("error_message") @db.Text
  processedAt            DateTime?            @map("processed_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, eventType, createdAt])
  @@index([status, createdAt])
  @@map("billing_webhook_events")
}

model TierRoutingModel {
  id        String         @id @default(cuid(2))
  tier      ComplexityTier
  modelId   String         @map("model_id")
  priority  Int            @default(1)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([tier, modelId])
  @@index([tier, priority])
  @@map("tier_routing_models")
}
