<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Invoice <%= invoiceNumber %>
  </title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Arial, sans-serif;
      background: #ffffff;
      color: #1f2733;
      font-size: 13px;
    }

    .page {
      max-width: 780px;
      margin: 0 auto;
      padding: 40px 48px;
    }

    /* Letterhead */
    .letterhead {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 24px;
      border-bottom: 3px solid #1a1f2e;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-mark {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: linear-gradient(135deg, #1a1f2e 0%, #3b4358 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: 700;
      font-family: Georgia, 'Times New Roman', serif;
      flex-shrink: 0;
    }

    .brand-name {
      font-size: 19px;
      font-weight: 700;
      color: #1a1f2e;
      letter-spacing: 0.01em;
    }

    .brand-sub {
      margin-top: 2px;
      font-size: 11.5px;
      color: #6b7280;
    }

    .doc-title {
      text-align: right;
    }

    .doc-title h1 {
      margin: 0;
      font-size: 24px;
      letter-spacing: 0.08em;
      color: #1a1f2e;
    }

    .doc-title .doc-number {
      margin-top: 4px;
      font-size: 12.5px;
      color: #6b7280;
    }

    .status-pill {
      display: inline-block;
      margin-top: 10px;
      padding: 4px 14px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .status-paid {
      background: #e6f6ec;
      color: #1a7f43;
    }

    .status-pending {
      background: #fff4e0;
      color: #9a5b00;
    }

    .status-failed {
      background: #fdecec;
      color: #b3261e;
    }

    /* Billed to / invoice info */
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin: 28px 0;
    }

    .info-label {
      margin: 0 0 8px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #9aa3b2;
    }

    .info-block p {
      margin: 3px 0;
      line-height: 1.5;
      color: #333d4d;
    }

    .info-block .name {
      font-size: 14px;
      font-weight: 700;
      color: #1a1f2e;
    }

    .info-block .kv {
      display: flex;
      justify-content: space-between;
      max-width: 260px;
    }

    .info-block .kv span:first-child {
      color: #6b7280;
    }

    .info-block .kv span:last-child {
      font-weight: 600;
      color: #1a1f2e;
    }

    /* Line items table */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
    }

    thead th {
      background: #1a1f2e;
      color: #ffffff;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      text-align: left;
      padding: 10px 12px;
    }

    thead th.num,
    tbody td.num {
      text-align: right;
    }

    tbody td {
      padding: 12px;
      border-bottom: 1px solid #e8eaee;
      color: #333d4d;
    }

    tbody tr:nth-child(even) {
      background: #fafbfc;
    }

    /* Totals */
    .totals {
      display: flex;
      justify-content: flex-end;
      margin-top: 20px;
    }

    .totals-card {
      min-width: 280px;
    }

    .totals-row {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      color: #4b5563;
    }

    .totals-row.total {
      margin-top: 8px;
      padding: 12px 14px;
      background: #1a1f2e;
      color: #ffffff;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 700;
    }

    /* Footer */
    .footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #e8eaee;
      display: flex;
      justify-content: space-between;
      gap: 24px;
    }

    .footer .company {
      font-size: 12px;
      color: #4b5563;
      line-height: 1.6;
    }

    .footer .company strong {
      display: block;
      color: #1a1f2e;
      font-size: 13px;
      margin-bottom: 2px;
    }

    .footer .note {
      max-width: 280px;
      font-size: 11px;
      color: #9aa3b2;
      line-height: 1.6;
      text-align: right;
    }

    .thankyou {
      margin-top: 24px;
      text-align: center;
      font-size: 12px;
      color: #9aa3b2;
      letter-spacing: 0.04em;
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="letterhead">
      <div class="brand">
        <div class="brand-mark"><img src="/ColabOne_Logo.png" alt="ColabOne Logo" /></div>
        <div>
          <div class="brand-name">Colab One</div>
          <div class="brand-sub">Unified AI gateway billing</div>
        </div>
      </div>
      <div class="doc-title">
        <h1>INVOICE</h1>
        <div class="doc-number"># <%= invoiceNumber %>
        </div>
        <div
          class="status-pill <%= (invoiceStatus || '').toLowerCase().match(/paid|success|complete/) ? 'status-paid' : (invoiceStatus || '').toLowerCase().match(/fail|declin|cancel/) ? 'status-failed' : 'status-pending' %>">
          <%= invoiceStatus %>
        </div>
      </div>
    </div>

    <div class="info-grid">
      <div class="info-block">
        <p class="info-label">Billed To</p>
        <p class="name">
          <%= customerName %>
        </p>
        <p>
          <%= customerEmail %>
        </p>
        <% if (typeof customerAddress !=='undefined' && customerAddress) { %>
          <p>
            <%= customerAddress %>
          </p>
          <% } %>
            </p>
      </div>
      <div class="info-block">
        <p class="info-label">Invoice Details</p>
        <div class="kv"><span>Invoice Date</span><span>
            <%= invoiceDate %>
          </span></div>
        <div class="kv"><span>Payment Reference</span><span>
            <%= paymentReference %>
          </span></div>
        <div class="kv"><span>Payment Provider</span><span>
            <%= providerName %>
          </span></div>
        <div class="kv"><span>Currency</span><span>
            <%= currency %>
          </span></div>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Description</th>
          <th class="num">Quantity</th>
          <th class="num">Unit Price</th>
          <th class="num">Amount</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <%= itemDescription %>
          </td>
          <td class="num">1</td>
          <td class="num">
            <%= formattedAmount %>
              <%= currency %>
          </td>
          <td class="num">
            <%= formattedAmount %>
              <%= currency %>
          </td>
        </tr>
      </tbody>
    </table>

    <div class="totals">
      <div class="totals-card">
        <div class="totals-row">
          <span>Subtotal</span>
          <span>
            <%= formattedAmount %>
              <%= currency %>
          </span>
        </div>
        <div class="totals-row">
          <span>Tax</span>
          <span>0.00 <%= currency %></span>
        </div>
        <div class="totals-row total">
          <span>Total Paid</span>
          <span>
            <%= formattedAmount %>
              <%= currency %>
          </span>
        </div>
      </div>
    </div>

    <div class="footer">
      <div class="company">
        <strong>Colab Intelligence Pvt Ltd</strong>
        B202, Takshashila, Samant Estate,<br />
        Goregaon East, Mumbai - 400063<br />
        support@colabone.ai
      </div>
      <div class="note">
        This is a system-generated invoice for your Colab Intelligence wallet
        top-up and does not require a physical signature. For billing queries,
        contact support@colabone.ai and reference the invoice number above.
      </div>
    </div>

    <div class="thankyou">Thank you for building with Colab Intelligence</div>
  </div>
</body>

</html>