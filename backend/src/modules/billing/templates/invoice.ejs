<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Model Bridge Invoice</title>
  <style>
    body {
      margin: 0;
      padding: 32px;
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #172033;
    }
    .invoice {
      max-width: 860px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08);
    }
    .header {
      display: flex;
      justify-content: space-between;
      gap: 24px;
      border-bottom: 1px solid #e5e7eb;
      padding-bottom: 24px;
      margin-bottom: 24px;
    }
    .brand h1 {
      margin: 0 0 8px;
      font-size: 28px;
    }
    .brand p,
    .meta p,
    .billto p,
    .summary p {
      margin: 6px 0;
      line-height: 1.5;
    }
    .section-title {
      margin: 0 0 12px;
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #64748b;
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-bottom: 24px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
    }
    th, td {
      padding: 14px 12px;
      border-bottom: 1px solid #e5e7eb;
      text-align: left;
      font-size: 14px;
    }
    th {
      color: #64748b;
      font-weight: 600;
    }
    .totals {
      display: flex;
      justify-content: flex-end;
      margin-top: 24px;
    }
    .totals-card {
      min-width: 260px;
      background: #f8fafc;
      border-radius: 16px;
      padding: 20px;
    }
    .totals-row {
      display: flex;
      justify-content: space-between;
      margin: 8px 0;
    }
    .totals-row.total {
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid #dbe2ea;
      font-size: 18px;
      font-weight: 700;
    }
    .footer {
      margin-top: 32px;
      color: #64748b;
      font-size: 13px;
    }
  </style>
</head>
<body>
  <div class="invoice">
    <div class="header">
      <div class="brand">
        <h1>Model Bridge</h1>
        <p>Unified AI gateway billing invoice</p>
        <p>support@modelbridge.ai</p>
      </div>
      <div class="meta">
        <p><strong>Invoice #:</strong> <%= invoiceNumber %></p>
        <p><strong>Invoice Date:</strong> <%= invoiceDate %></p>
        <p><strong>Status:</strong> <%= invoiceStatus %></p>
        <p><strong>Payment Ref:</strong> <%= paymentReference %></p>
      </div>
    </div>

    <div class="grid">
      <div class="billto">
        <p class="section-title">Billed To</p>
        <p><strong><%= customerName %></strong></p>
        <p><%= customerEmail %></p>
        <p>User ID: <%= userId %></p>
      </div>
      <div class="summary">
        <p class="section-title">Summary</p>
        <p>Wallet top-up for prepaid Model Bridge credits.</p>
        <p>Provider: <%= providerName %></p>
        <p>Currency: <%= currency %></p>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Description</th>
          <th>Quantity</th>
          <th>Unit Price</th>
          <th>Amount</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= itemDescription %></td>
          <td>1</td>
          <td><%= formattedAmount %> <%= currency %></td>
          <td><%= formattedAmount %> <%= currency %></td>
        </tr>
      </tbody>
    </table>

    <div class="totals">
      <div class="totals-card">
        <div class="totals-row">
          <span>Subtotal</span>
          <span><%= formattedAmount %> <%= currency %></span>
        </div>
        <div class="totals-row">
          <span>Tax</span>
          <span>0.00 <%= currency %></span>
        </div>
        <div class="totals-row total">
          <span>Total</span>
          <span><%= formattedAmount %> <%= currency %></span>
        </div>
      </div>
    </div>

    <div class="footer">
      <p>This is a sample platform invoice generated by Model Bridge after successful payment completion.</p>
      <p>Thank you for building with Model Bridge.</p>
    </div>
  </div>
</body>
</html>
